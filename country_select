import React, { use, useState } from "react"

function App()
{
   const [city,setcity]=useState([])
   const data = [
      { country: "India", cities: ["Delhi", "Mumbai", "Hyderabad"] },
      { country: "USA", cities: ["New York", "Chicago"] },
      { country: "UK", cities: ["London", "Manchester"] }
    ];

    const handelchange=(e)=>
      {
         let selected=data.find((x)=>x.country===e.target.value)

        console.log(selected)
        setcity(selected.cities)
      }
   return(
      <div>
         <select
       
       onChange={handelchange}
         

         >{data.map((x)=><option>{x.country}</option>)}</select>

         <div><select>{city.map((x)=><option>{x}</option>)}</select>
         </div>
      </div>
   )
}
export default App
