import React,{useState} from "react"

function App()
{
  const [city,setcity]=useState([])
  const data = [
    { country: "India", cities: ["Delhi", "Mumbai", "Hyderabad"] },
    { country: "USA", cities: ["New York", "Chicago"] },
    { country: "UK", cities: ["London", "Manchester"] }
  ];
  const handlechange=(e)=>
    {
      console.log(e.target.value)

      let selected=data.find((x)=>x.country===e.target.value)
      setcity(selected.cities)
      console.log(city)
    }
  return(
    <div>
       <h1>country select</h1>

       <select onChange={handlechange}>
        {data.map((x)=><option>{x.country}</option>)}
       </select>
       <select>{city.map((x)=><option>{x}</option>)}</select>
 
    </div>
  )
}
export default App
