import React,{useReducer} from "react"
let id=null
function App() 
{

  const reducer=(state,action)=>
    {
        switch(action.type)
        {
             case "increment":
              return state+1

              case "stop":
              return state
        }
    }
    let intial=0
  const [count,dispatch]=useReducer(reducer,intial)



  let increment=()=>
    {
     
      id= setInterval(()=>
      {
        dispatch({
          type:"increment"
        })
      },1000)

     
    }

    let stop=()=>
      {
         clearInterval(id)
         dispatch({
            type:"stop"
         })
      }
  
  

 
  return(
    <div>
      <h1>use reducer</h1>
        {count}<br/>
      <button onClick={increment}>start</button>
      <button onClick={stop}>stop</button>


    </div>
  )
  
}
export default App
