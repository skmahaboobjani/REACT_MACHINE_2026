import React, { useState } from "react"
function App()
{
  const lists=["apple","mango","grapes"]
  const [check,setcheck]=useState([])
  const [selectAll,SetselectAll]=useState([])

  const handlecheck=(x)=>
    {
       if(check.includes(x))
        {
            setcheck(check.filter((y)=>y!=x))
        }
        else
        {
           setcheck([...check,x])
        }
    }

    const selctlogic=(lists)=>
      {
         if(lists.length===check.length)
          {
             setcheck([])
          }
          else{
             setcheck(lists)
          }

      }

  return(
    <div>
      <h1>check box</h1>
      <input type={"checkbox"} 
      checked={lists.length===check.length} 
      onChange={()=>selctlogic(lists)}
      />
      selectAll
      {lists.map((x)=><li>
        <input 
        checked={check.includes(x)} 
        
        onChange={()=>handlecheck(x)}

        type={"checkbox"}/> {x}</li>
        )}
        
        <div>
          selected items:
          {check.map((x)=><li>{x}</li>)}
          </div>
    </div>
  )
}
export default App
