import React, { useState } from "react";


function App()
{
   const [check,setcheck]=useState([])
   const lists=["apple","mango","grapes"]

   const handlechange=(x)=>
      {
         if(check.includes(x))
            {
               setcheck([check.filter((y)=>y!=x)])
            }
            else
            {
               setcheck([...check,x])
            }
      }

      const handlechange_two=(lists)=>
         {
             if(lists.length===check.length)
               {
                  setcheck([])
               }
               else
               {
                  setcheck(lists)
               }
         }
   return(
    <div>
      <div>
         <input

         checked={lists.length===check.length}
         onChange={()=>handlechange_two(lists)}
         
         type={"checkbox"}/> Select_All
         </div>
      {lists.map((x)=><li><input
      onChange={()=>handlechange(x)}
      checked={check.includes(x)}
       type={"checkbox"}/>{x}</li>)}

       <div>{check.map((x)=><li>{x}</li>)}</div>
    </div>
   )
}
export default App
